DJANGO_DEBUG=true
# Replace with a long random secret; never commit your real .env.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=Asia/Kolkata
DB_ENGINE=sqlite
# For PostgreSQL, set DB_ENGINE=postgresql and supply these values:
DB_NAME=navapack_erp
DB_USER=navapack
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# RDS certificate verification (relative paths resolve from Backend/):
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=./global-bundle.pem

# Customer quotation delivery. No real sends occur until configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=
# Meta WhatsApp Business Cloud API (recipient is chosen in the form).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
# Approved template with DOCUMENT header and one body parameter (quotation number).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
